{
  "name": "dexyd",
  "version": "0.0.11",
  "description": "dexyd bridge foundation",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mobile:install": "cd mobile/dexydMobile && npm install",
    "mobile:start": "cd mobile/dexydMobile && npm start",
    "mobile:test": "cd mobile/dexydMobile && npm test",
    "mobile:android": "cd mobile/dexydMobile && npm run android",
    "tui": "bash bin/dexyd --tui",
    "dexyd": "bash bin/dexyd",
    "install:linux": "bash scripts/install.sh",
    "mobile:ios": "cd mobile/dexydMobile && npm run ios",
    "mobile:ios:device": "cd mobile/dexydMobile && npm run ios:device",
    "mobile:ios:pods": "cd mobile/dexydMobile && npm run ios:pods",
    "android:all": "bash dev/scripts/run-all.sh",
    "android:all:tui": "bash dev/scripts/run-all.sh --with-tui",
    "android:all:debug": "bash dev/scripts/run-all.sh --debug-metro",
    "android:all:debug:tui": "bash dev/scripts/run-all.sh --debug-metro --with-tui",
    "firewall:open": "bash dev/scripts/firewall-port.sh"
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "better-sqlite3": "^12.4.6",
    "fastify": "^5.6.1",
    "pino": "^10.1.0",
    "qrcode": "^1.5.4",
    "smol-toml": "^1.4.2",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "bin": {
    "dexyd": "./bin/dexyd"
  }
}
